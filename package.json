{
  "name": "drk-launcher",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "DRK Launcher - Minecraft Launcher",
  "author": "DRK Team",
  "main": "build-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-electron.mjs && vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:publish": "node scripts/publish-release.mjs",
    "release": "npm version patch --no-git-tag-version && npm run dist:publish",
    "release:minor": "npm version minor --no-git-tag-version && npm run dist:publish",
    "release:major": "npm version major --no-git-tag-version && npm run dist:publish",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.3",
    "@types/node-fetch": "^2.6.13",
    "@types/yauzl": "^2.10.3",
    "archiver": "^7.0.1",
    "electron-updater": "^6.1.7",
    "framer-motion": "^12.23.25",
    "node-fetch": "^2.7.0",
    "node-stream-zip": "^1.15.0",
    "prismarine-auth": "^2.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "react-skinview3d": "^7.0.0",
    "skinview3d": "^3.4.1",
    "tar": "^6.2.1",
    "three": "^0.181.2",
    "tree-kill": "^1.2.2",
    "unzip-stream": "^0.3.4",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^20.19.25",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "bytenode": "^1.5.7",
    "concurrently": "^9.2.1",
    "crypto-browserify": "^3.12.1",
    "electron": "^39.2.4",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "javascript-obfuscator": "^5.1.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "postcss": "^8.4.31",
    "stream-browserify": "^3.0.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.15.5",
    "vite-plugin-electron-renderer": "^0.14.0",
    "wait-on": "^9.0.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^9.4.0"
  },
  "build": {
    "appId": "com.drk.launcher",
    "productName": "DRK Launcher",
    "publish": [
      {
        "provider": "github",
        "owner": "Haroldpgr",
        "repo": "DRK-Launcher-dev"
      }
    ],
    "files": [
      "dist/**",
      "build-electron/**",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "public/",
        "to": "public/"
      }
    ],
    "extraResources": [
      {
        "from": "Icono/Logo.png",
        "to": "Icono/Logo.png"
      },
      {
        "from": "build/Logo.ico",
        "to": "build/Logo.ico"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "DRK-Launcher-${version}-Setup.exe",
      "icon": "build/Logo.ico",
      "sign": null,
      "compression": "maximum",
      "publisherName": "DRK Team",
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "DRK-Launcher-${version}.AppImage",
      "category": "Utility",
      "compression": "maximum"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/Logo.ico",
      "uninstallerIcon": "build/Logo.ico",
      "include": "build/installer.nsh",
      "license": "build/License.txt",
      "warningsAsErrors": false
    },
    "compression": "maximum",
    "removePackageScripts": true,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false
  }
}
